# Ethereum node endpoints. All collectors read base URLs from env.
# Local SSH-tunnel example:
#   ssh -N -L 8545:127.0.0.1:8545 -L 5052:127.0.0.1:5052 -L 5054:127.0.0.1:5054 fl0wizy@<node-host>
# Production: use Tailscale or WireGuard. Never expose these ports publicly.
EXECUTION_RPC_URL=http://127.0.0.1:8545
BEACON_API_URL=http://127.0.0.1:5052
LIGHTHOUSE_METRICS_URL=http://127.0.0.1:5054/metrics

# PostgreSQL. asyncpg-style URL.
DATABASE_URL=postgresql://collector:collector@127.0.0.1:5432/eth_da

# Identity
NODE_NAME=bonda
NETWORK=mainnet

# Cadence
SLOT_INTERVAL_SECONDS=12

# Feature flags (default off)
ENABLE_COLUMN_PROBES=false
ENABLE_SELF_PROBE_ETHEREUM=false
ENABLE_BATCHER_BALANCES=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----------------------------------------------------------------------
# Ethereum self-probe (DISABLED by default; scaffolding only in MVP).
# Refuses to send unless ENABLE_SELF_PROBE_ETHEREUM=true AND
# ETH_PROBE_DRY_RUN=false AND key is present AND caps are not exceeded.
# Put the private key here MANUALLY; never commit.
# ----------------------------------------------------------------------
ETH_PROBE_PRIVATE_KEY=
# FROM is derived from the private key automatically. If you set this and it
# does not match the derived address, all submits are refused.
ETH_PROBE_FROM_ADDRESS=
# TO defaults to FROM (self-send) when empty.
ETH_PROBE_TO_ADDRESS=
# 6h between submits = 72 probes over 18 days; cheap and statistically enough
# for data_match verification. Lower (e.g. 60) for denser sampling.
ETH_PROBE_INTERVAL_MINUTES=360
ETH_PROBE_TOTAL_SPEND_CAP_ETH=0.075
ETH_PROBE_DAILY_SPEND_CAP_ETH=0.006
ETH_PROBE_MAX_FEE_PER_GAS_GWEI=2
ETH_PROBE_MAX_PRIORITY_FEE_PER_GAS_GWEI=0.1
ETH_PROBE_MAX_FEE_PER_BLOB_GAS_GWEI=0.05
ETH_PROBE_MIN_WALLET_BALANCE_ETH=0.005
ETH_PROBE_DRY_RUN=true
